# ===== Base de datos PostgreSQL =====
DATABASE_URL=postgresql://miquiosco_app:password@localhost:5432/miquiosco

# ===== Autenticación y sesión =====
# Genera un secret de al menos 32 caracteres: openssl rand -base64 48
JWT_SECRET=REEMPLAZA_CON_UN_SECRET_ALEATORIO
# OJO: las runtimeConfig public leen variables con prefijo NUXT_PUBLIC_
NUXT_PUBLIC_SESSION_EXPIRATION_TRABAJADOR_HORAS=24
NUXT_PUBLIC_SESSION_INACTIVITY_TIMEOUT_JEFE_SEGUNDOS=60

# ===== Servidor Nitro =====
NITRO_PORT=3000
NITRO_HOST=0.0.0.0

# ===== Pool de conexiones PostgreSQL =====
# En serverless (Vercel) cada instancia abre su propio pool: usar 5.
# En local/VPS se puede dejar en 10.
PG_POOL_MAX=10

# ===== Versiones de la APK (sistema de actualización) =====
# APP_MIN_VERSION_CODE=0 desactiva el enforcement (útil en dev).
# La APK instalada envía el header x-app-version-code; el servidor
# responde 426 si es menor que APP_MIN_VERSION_CODE.
APP_LATEST_VERSION_CODE=1
APP_LATEST_VERSION_NAME=1.0
APP_MIN_VERSION_CODE=0
APP_APK_URL=/apk/miquiosco-v1.0.apk
APP_CHANGELOG=
APP_METODO_SUGERIDO=navegador

# ===== API base para cliente móvil =====
# IP de la laptop en la red local. El dispositivo Android debe apuntar aquí.
# En emulador de Android usar 10.0.2.2 para acceder al host.
#NUXT_PUBLIC_SYNC_SERVER_URL=http://192.168.1.100:3000
NUXT_PUBLIC_SYNC_SERVER_URL=http://127.0.0.1:3000
