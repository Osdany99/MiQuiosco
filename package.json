{
  "name": "MiQuiosco",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint . --cache",
    "typecheck": "nuxt typecheck",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:generate:sqlite": "drizzle-kit generate --config drizzle.sqlite.config.ts",
    "test": "node --test tests/unit.test.js tests/inventario.test.js tests/recargas.test.js",
    "db:reset:local": "echo 'Usa resetLocalDatabase() desde la consola del navegador (F12 > App > Consola). Se exporta por useLocalDb().'",
    "db:seed": "bun run server/database/seed.ts",
    "cap:sync": "cap sync android",
    "cap:open": "cap open android",
    "android:build": "node scripts/gradle.mjs assembleDebug",
    "android:assemble-release": "node scripts/gradle.mjs assembleRelease",
    "iconos": "node scripts/generar-iconos.mjs"
  },
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "10.0.0",
    "@aparajita/capacitor-secure-storage": "8.0.1",
    "@capacitor-community/sqlite": "^8.1.0",
    "@capacitor/android": "^8.4.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.4.1",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@iconify-json/lucide": "^1.2.111",
    "@internationalized/date": "^3.12.2",
    "@nuxt/ui": "^4.8.2",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "@vueuse/core": "^14.3.0",
    "@vueuse/nuxt": "^14.3.0",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.2",
    "echarts": "^6.1.0",
    "jsonwebtoken": "^9.0.3",
    "nuxt": "^4.4.6",
    "pg": "^8.22.0",
    "sortablejs": "^1.15.7",
    "tailwindcss": "^4.3.0",
    "vue": "^3.5.35",
    "vue-echarts": "^8.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.1",
    "@nuxt/eslint": "^1.15.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.4.1",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.3"
  },
  "packageManager": "pnpm@11.5.2"
}
